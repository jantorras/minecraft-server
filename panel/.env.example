# Copia aquest fitxer a .env i omple'l.

# Servidors gestionats pel panell (pàgina «Servidors»). Ho deixa posat install.sh.
# On viuen els servidors: servers/<id>/, backups/<id>/, plugins/{paper,velocity}/, trash/
# MC_ROOT=/opt/minecraft
# Base de dades de LuckPerms compartida (contenidor «mariadb» a la xarxa Docker «mcnet»)
# LP_DB_ADDRESS=mariadb
# LP_DB_NAME=luckperms
# LP_DB_USER=luckperms
# LP_DB_PASSWORD=

# Mode d'un sol servidor (proves en local o instal·lació antiga): només es fa servir
# mentre no hi hagi cap servidor creat des del panell.
# On escolta el plugin Bridge (mateixa VM)
BRIDGE_URL=http://127.0.0.1:8765
# El token de plugins/Bridge/config.yml
BRIDGE_TOKEN=

# Servidor de Minecraft en Docker (opcional): estat, iniciar/aturar/reiniciar, còpies i consola.
# Nom del contenidor (docker-compose.yml de /opt/minecraft)
MC_CONTAINER=mc-claude
# Directori de dades del servidor (bind mount del contenidor): fitxers, plugins, world...
MC_DATA_DIR=/opt/minecraft/data
# On es guarden les còpies de seguretat (tar.gz), fora del bind mount
MC_BACKUPS_DIR=/opt/minecraft/backups
# RCON (consola): mateixos valors que RCON_PASSWORD/RCON_PORT del docker-compose.yml
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD=

# El panell parla amb Docker pel socket /var/run/docker.sock: l'usuari que executa
# el panell ha de ser membre del grup "docker" (sudo usermod -aG docker <usuari>).

# Base de dades del panell (usuaris, sessions, registre)
DATABASE_PATH=data/panel.db

# Només en producció (npm run build + node build):
# URL pública per on s'accedeix al panell (necessària per als formularis)
# ORIGIN=https://panell.exemple.cat
# PORT=3000
# HOST=127.0.0.1
